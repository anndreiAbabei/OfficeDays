# Select the `local` or `docker` environment in Rider's "Run with" menu.
# A value named apiToken in http-client.private.env.json overrides this OS variable.
@apiToken = {{OFFICEDAYS_TOKEN}}

### Current user's current-month status
GET {{baseUrl}}/api/status
Authorization: Bearer {{apiToken}}
Accept: application/json

### Selected-month status
GET {{baseUrl}}/api/status?year=2026&month=9
Authorization: Bearer {{apiToken}}
Accept: application/json

### Record today as an office day (iOS Shortcut request)
POST {{baseUrl}}/api/attendance
Authorization: Bearer {{apiToken}}

### Manually record a past office day
PUT {{baseUrl}}/api/attendance/2026-09-15
Authorization: Bearer {{apiToken}}

### List attendance for a month
GET {{baseUrl}}/api/attendance?year=2026&month=9
Authorization: Bearer {{apiToken}}
Accept: application/json

### Remove an attendance day
DELETE {{baseUrl}}/api/attendance/2026-09-15
Authorization: Bearer {{apiToken}}

### Add vacation and retain its ID
POST {{baseUrl}}/api/vacations
Authorization: Bearer {{apiToken}}
Content-Type: application/json

{
  "from": "2026-09-21",
  "to": "2026-09-25"
}

> {%
    client.global.set("vacationId", response.body.id);
%}

### List vacations for a month
GET {{baseUrl}}/api/vacations?year=2026&month=9
Authorization: Bearer {{apiToken}}
Accept: application/json

### Remove the vacation created above
DELETE {{baseUrl}}/api/vacations/{{vacationId}}
Authorization: Bearer {{apiToken}}

### List this user's API tokens
GET {{baseUrl}}/api/tokens
Authorization: Bearer {{apiToken}}
Accept: application/json

### Create another API token and retain its ID
POST {{baseUrl}}/api/tokens
Authorization: Bearer {{apiToken}}
Content-Type: application/json

{
  "name": "Test admin token"
}

> {%
    client.global.set("createdTokenId", response.body.id);
    client.log("The raw token is shown only in this response. Copy it now if needed.");
%}

### Revoke the token created above
DELETE {{baseUrl}}/api/tokens/{{createdTokenId}}
Authorization: Bearer {{apiToken}}
