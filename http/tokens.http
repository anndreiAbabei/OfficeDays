# Select an environment from http-client.env.json in Rider's "Run with" menu.
# A value named apiToken in http-client.private.env.json overrides this OS variable.
@apiToken = {{$env.OFFICEDAYS_API_TOKEN}}

### Read the configured iOS/iPadOS shortcut link
GET {{baseUrl}}/api/automation/ios
Authorization: Bearer {{apiToken}}
Accept: application/json

### List this user's API tokens
GET {{baseUrl}}/api/tokens
Authorization: Bearer {{apiToken}}
Accept: application/json

### Create another API token and retain its ID
POST {{baseUrl}}/api/tokens
Authorization: Bearer {{apiToken}}
Content-Type: application/json

{
  "name": "Test admin token"
}

> {%
    client.global.set("createdTokenId", response.body.id);
    client.log("The raw token is shown only in this response. Copy it now if needed.");
%}

### Create a token labeled for the iPhone/iPad guide (omit purpose for a generic token)
POST {{baseUrl}}/api/tokens
Authorization: Bearer {{apiToken}}
Content-Type: application/json

{
  "name": "Work iPhone",
  "purpose": "ios-shortcuts"
}

### Rename an active token (409 Conflict if revoked)
PATCH {{baseUrl}}/api/tokens/{{createdTokenId}}
Authorization: Bearer {{apiToken}}
Content-Type: application/json

{
  "name": "Renamed test token"
}

### Revoke the token created above
DELETE {{baseUrl}}/api/tokens/{{createdTokenId}}
Authorization: Bearer {{apiToken}}

### Permanently delete the revoked token from history
DELETE {{baseUrl}}/api/tokens/{{createdTokenId}}/permanent
Authorization: Bearer {{apiToken}}
