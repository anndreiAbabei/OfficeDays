# Set registrationPassword in the ignored http-client.private.env.json for the selected environment.
# Select the `local` or `docker` environment in Rider's "Run with" menu.
# Values in http-client.private.env.json override these operating-system variables.
@username = {{OFFICEDAYS_USERNAME}}
@password = {{OFFICEDAYS_PASSWORD}}

### List valid holiday jurisdictions (anonymous)
GET {{baseUrl}}/api/holiday-jurisdictions
Accept: application/json

### Create a normal user (anonymous; change the username before repeating)
# Supply requirementMode and requirementValue together. Percentage accepts 0–100; DaysPerWeek accepts 0–5.
# Omitting both during registration defaults to Percentage with value 50.
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "username": "andrei",
  "password": "{{registrationPassword}}",
  "timeZoneId": "Europe/Bucharest",
  "countryCode": "RO",
  "email": null,
  "requirementMode": "Percentage",
  "requirementValue": 50
}

### Log in and store the persistent session cookie
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### Get and retain an antiforgery token for cookie-authenticated mutations
GET {{baseUrl}}/api/auth/csrf
Accept: application/json

> {%
    client.global.set("csrfToken", response.body.token);
%}

### Show the signed-in user
GET {{baseUrl}}/api/auth/me
Accept: application/json

### Update the signed-in user's email (run login and CSRF requests first)
PUT {{baseUrl}}/api/users/me
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "email": "andrei@example.com"
}

> {%
    client.test("Email is updated", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.email === "andrei@example.com", "Expected updated email");
        client.global.set("savedRequirementMode", response.body.requirementMode);
        client.global.set("savedRequirementValue", response.body.requirementValue);
    });
%}

### Clear the signed-in user's optional email
# Run the profile update above first. Profile updates preserve the attendance requirement.
PUT {{baseUrl}}/api/users/me
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "email": null
}

> {%
    client.test("Email is cleared", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.email === null, "Expected null email");
        client.assert(response.body.requirementMode === client.global.get("savedRequirementMode"), "Expected requirement mode to be preserved");
        client.assert(response.body.requirementValue === client.global.get("savedRequirementValue"), "Expected requirement value to be preserved");
    });
%}

### List attendance requirements and retain baseline ID
GET {{baseUrl}}/api/users/me/requirements
Accept: application/json

> {%
    client.global.set("baselineRequirementId", response.body.items.find(x => x.isBaseline).id);
%}

### Schedule a requirement (one entry per effective month)
POST {{baseUrl}}/api/users/me/requirements
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "startingFrom": "2027-01-01",
  "requirementMode": "Percentage",
  "requirementValue": 60
}

> {%
    client.global.set("requirementId", response.body.id);
%}

### Change the scheduled requirement to a weekly average or correct its month
PUT {{baseUrl}}/api/users/me/requirements/{{requirementId}}
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "startingFrom": "2027-01-01",
  "requirementMode": "DaysPerWeek",
  "requirementValue": 3
}

### Correct the initial requirement without moving its starting date
PUT {{baseUrl}}/api/users/me/requirements/{{baselineRequirementId}}
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "startingFrom": "0001-01-01",
  "requirementMode": "Percentage",
  "requirementValue": 50
}

### Delete a scheduled change (the preceding requirement extends until the next change)
DELETE {{baseUrl}}/api/users/me/requirements/{{requirementId}}
X-CSRF-TOKEN: {{csrfToken}}

### Log out
POST {{baseUrl}}/api/auth/logout
X-CSRF-TOKEN: {{csrfToken}}
