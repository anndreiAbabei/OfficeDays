# Set registrationPassword in the ignored http-client.private.env.json for the selected environment.
# Select the `local` or `docker` environment in Rider's "Run with" menu.
# Values in http-client.private.env.json override these operating-system variables.
@username = {{OFFICEDAYS_USERNAME}}
@password = {{OFFICEDAYS_PASSWORD}}

### List valid holiday jurisdictions (anonymous)
GET {{baseUrl}}/api/holiday-jurisdictions
Accept: application/json

### Create a normal user (anonymous; change the username before repeating)
# requiredOfficePercentage accepts whole numbers from 0 to 100; omitted values default to 50.
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "username": "andrei",
  "password": "{{registrationPassword}}",
  "timeZoneId": "Europe/Bucharest",
  "countryCode": "RO",
  "email": null,
  "requiredOfficePercentage": 50
}

### Log in and store the persistent session cookie
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### Get and retain an antiforgery token for cookie-authenticated mutations
GET {{baseUrl}}/api/auth/csrf
Accept: application/json

> {%
    client.global.set("csrfToken", response.body.token);
%}

### Show the signed-in user
GET {{baseUrl}}/api/auth/me
Accept: application/json

### Update the signed-in user's email and office requirement (run login and CSRF requests first)
PUT {{baseUrl}}/api/users/me
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "email": "andrei@example.com",
  "requiredOfficePercentage": 75
}

> {%
    client.test("Email and office requirement are updated", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.email === "andrei@example.com", "Expected updated email");
        client.assert(response.body.requiredOfficePercentage === 75, "Expected 75% office requirement");
        client.global.set("savedOfficePercentage", response.body.requiredOfficePercentage);
    });
%}

### Clear the signed-in user's optional email
# Run the profile update above first. Omitting requiredOfficePercentage preserves its saved value.
PUT {{baseUrl}}/api/users/me
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "email": null
}

> {%
    client.test("Email is cleared", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.email === null, "Expected null email");
        client.assert(response.body.requiredOfficePercentage === client.global.get("savedOfficePercentage"), "Expected office requirement to be preserved");
    });
%}

### Log out
POST {{baseUrl}}/api/auth/logout
X-CSRF-TOKEN: {{csrfToken}}
