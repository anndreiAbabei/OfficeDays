{
  "ConnectionStrings": {
    "Default": "Data Source=officedays.db"
  },
  "Authentication": {
    "CookieExpireTimeSpan": "12:00:00"
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Security": {
    "RequireHttpsForBearerTokens": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "KnownProxies": []
  },
  "RateLimiting": {
    "MaxBodyBytes": 65536,
    "MaxPartitions": 10000,
    "Source": {
      "Permits": 600,
      "WindowSeconds": 60
    },
    "Api": {
      "Permits": 120,
      "WindowSeconds": 60
    },
    "Token": {
      "Permits": 60,
      "WindowSeconds": 60
    },
    "Login": {
      "Permits": 20,
      "WindowSeconds": 300
    },
    "LoginAccount": {
      "Permits": 10,
      "WindowSeconds": 300
    },
    "Registration": {
      "Permits": 5,
      "WindowSeconds": 3600
    },
    "Recovery": {
      "Permits": 10,
      "WindowSeconds": 900
    },
    "RecoveryAccount": {
      "Permits": 5,
      "WindowSeconds": 900
    },
    "Verification": {
      "Permits": 10,
      "WindowSeconds": 900
    },
    "Reports": {
      "Permits": 10,
      "WindowSeconds": 60
    }
  }
}
