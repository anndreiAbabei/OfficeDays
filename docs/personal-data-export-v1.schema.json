{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OfficeDays personal data export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "exportedAt",
    "application",
    "reportContext",
    "profile",
    "preferences",
    "requirementHistory",
    "attendance",
    "plans",
    "vacations",
    "holidayCalendar"
  ],
  "properties": {
    "format": {
      "const": "officedays-personal-data"
    },
    "formatVersion": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "OfficeDays"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reportContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calculationVersion",
        "localDate",
        "registrationLocalDate"
      ],
      "properties": {
        "calculationVersion": {
          "const": 1
        },
        "localDate": {
          "type": "string",
          "format": "date"
        },
        "registrationLocalDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "username",
        "normalizedUsername",
        "email",
        "timeZoneId",
        "holidayJurisdictionId",
        "isAdmin",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "username": {
          "type": "string"
        },
        "normalizedUsername": {
          "type": "string"
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeZoneId": {
          "type": "string"
        },
        "holidayJurisdictionId": {
          "type": "integer"
        },
        "isAdmin": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamDay"
      ],
      "properties": {
        "teamDay": {
          "enum": [
            null,
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday"
          ]
        }
      }
    },
    "requirementHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "userId",
          "startingFrom",
          "requiredOfficePercentage",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "startingFrom": {
            "type": "string",
            "format": "date"
          },
          "requiredOfficePercentage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "attendance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "userId",
          "date",
          "isManual",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "isManual": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "userId",
          "date",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "vacations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "userId",
          "from",
          "to",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "holidayCalendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "holidays"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "holidays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "holidayJurisdictionId",
              "date",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "holidayJurisdictionId": {
                "type": "integer"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "name": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
